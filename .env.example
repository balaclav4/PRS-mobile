# Firebase — copy to .env.local and fill in from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration
#
# .env.local is gitignored. Do not commit real values.
#
# These are inlined into the app bundle in plain text, which is expected: a
# Firebase web API key identifies the project, it is not a credential. Access is
# controlled by Firestore security rules, so make sure those are set before
# putting real data behind this.
#
# With these absent the app runs local-only with no account, which is the
# supported way to develop against this project without touching live data.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
