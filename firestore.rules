rules_version = '2';

// Access control for PRS. The Firebase web API key is public by design — it
// identifies the project and is inlined into every client bundle. These rules
// are the only thing actually protecting the data.
//
// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // A user's own data, and everything beneath it.
    //
    // The recursive wildcard is deliberate. Listing subcollections explicitly
    // (sessions, rifles, loads) left `loaddev` and `dopecards` unmatched, and
    // Firestore denies by default — the mobile app's load development projects
    // and dope cards would have been rejected without any rule appearing wrong.
    // A match on /users/{uid} alone does NOT cascade to subcollections, which is
    // the trap that made the explicit list look sufficient.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Contributed target images for model training.
    //
    // Shared rather than personal: the point is a corpus. So any signed-in user
    // may read it, but a contribution can only be created by the account that
    // stamps its own uid on it, and nothing may edit or delete an existing
    // record from a client — deletions happen server-side on request, so a
    // withdrawal is auditable rather than silent.
    //
    // Contributions carry no account identifier in the training set itself; the
    // uid below exists only so a client cannot forge submissions on behalf of
    // someone else.
    match /training-data/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.submittedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // Anything not matched above is denied. Stated rather than assumed, because
    // "it must be covered somewhere" is how collections end up world-readable.
  }
}
